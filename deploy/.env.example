# ---------------------------------------------------------------------------
# uSwap — variables de l'environnement Docker (deploy/compose.yaml)
#
# Copier en `deploy/.env` sur le serveur puis remplacer TOUTES les valeurs
# marquees `CHANGER-*` / `example.org`. Le fichier `deploy/.env` ne doit
# JAMAIS etre versionne ni transmis par Git.
#
# Aucune valeur ci-dessous n'est un secret reel.
#
# ===========================================================================
#  QUEL FICHIER .env POUR QUOI ?  (les trois sont DIFFERENTS)
# ===========================================================================
#
#   deploy/.env                    PRODUCTION (Docker). C'EST LE SEUL FICHIER
#                                  A REMPLIR POUR DEPLOYER. Il contient les
#                                  secrets du serveur et les identifiants
#                                  Google. Jamais versionne.
#
#   backend_new/.env               DEVELOPPEMENT LOCAL uniquement (npm run
#                                  start:dev). Il n'entre JAMAIS dans l'image
#                                  Docker : le backend en production recoit sa
#                                  configuration depuis deploy/.env.
#
#   frontend_new/frontend/.env     DEVELOPPEMENT LOCAL uniquement (npm run
#                                  dev). Il n'entre JAMAIS dans l'image Docker :
#                                  le frontend en production recoit ses
#                                  variables VITE_* au moment du build, depuis
#                                  deploy/.env.
#
#  Consequence : un identifiant Google mis dans backend_new/.env ou dans
#  frontend_new/frontend/.env fonctionne sur le poste de developpement mais
#  PAS en production. En production, tout se regle ici.
#
#  Les valeurs de developpement (mot de passe PostgreSQL local, mot de passe
#  d'application Gmail, comptes de demonstration) n'ont RIEN a faire ici :
#  le serveur a sa propre base, ses propres secrets et ses propres comptes.
# ===========================================================================

# Tag des images construites (informationnel : version livree).
USWAP_TAG=local

# Domaine public reel : sert de valeur par defaut aux variables de production
# (CORS_ORIGIN, PUBLIC_APP_URL, MAIL_FROM). Remplacez
# ``uswap.example.org`` ci-dessous par votre domaine avant tout build.
PUBLIC_APP_URL=https://uswap.example.org
CORS_ORIGIN=https://uswap.example.org

# --- Fichier deploy/.env : etat de la base PostgreSQL ----------------------
# Le compose.yaml fourni cree un conteneur PostgreSQL dedie (volume
# uswap-pgdata). Il ne doit PAS etre utilise tel quel si la base uSwap
# existante vit deja sur le PostgreSQL de l'hote ou dans un autre conteneur :
# les donnees existantes ne seraient pas visibles. Voir DEPLOYMENT_GUIDE.md.

# --- Base PostgreSQL (conteneur dedie uSwap) ------------------------------
POSTGRES_DB=uswap
POSTGRES_USER=uswap
POSTGRES_PASSWORD=CHANGER-mot-de-passe-fort

# --- Ports publics sur l'hote (lies a 127.0.0.1, destines au Nginx de l'hote)
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=3000

# --- Contextes de construction ------------------------------------------------
# Chemins RELATIFS a ce fichier (deploy/). Valeurs par defaut = arborescence
# REELLE de ce depot :
#
#   <racine>/backend_new            <- package.json + Dockerfile + prisma/
#   <racine>/frontend_new/frontend  <- package.json + Dockerfile + src/deploy/nginx.conf
#
# Ne renseigner ces variables que si le depot a ete reorganise sur le serveur.
# BACKEND_BUILD_CONTEXT=../backend_new
# FRONTEND_BUILD_CONTEXT=../frontend_new/frontend

# --- Comptes créés à l'initialisation du serveur ---------------------------
# Utilisés par le service `bootstrap` (profil tools) : c'est lui qui crée le
# référentiel et le super administrateur sur une base vierge.
#   docker compose ... --profile tools run --rm bootstrap
# Aucune donnée de démonstration (planning, pointage, congé, incident) n'est
# créée : le serveur démarre avec un référentiel propre.
SUPERADMIN_EMAIL=itadmin@upowa.org
SUPERADMIN_PASSWORD=CHANGER-mot-de-passe-superadmin-fort
SUPERADMIN_FULLNAME=Super administrateur

# Second compte administrateur (facultatif : laisser vide pour ne pas en créer).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULLNAME=Administrateur

# Mot de passe ré-appliqué au compte ADMIN si celui-ci est trouvé DÉSACTIVÉ au
# démarrage du backend (AdminBootstrapService.onModuleInit). Si le compte est
# actif, rien n'est modifié. Évite de dépendre de la valeur littérale du code.
ADMIN_BOOTSTRAP_PASSWORD=CHANGER-mot-de-passe-admin-initial

# --- Session / JWT ---------------------------------------------------------
# Chaines aleatoires de 32 caracteres minimum, differentes entre elles.
# Generation : openssl rand -base64 48
JWT_SECRET=CHANGER-secret-acces-aleatoire-64-caracteres-minimum
JWT_REFRESH_SECRET=CHANGER-secret-refresh-aleatoire-64-caracteres-minimum
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200

# --- Cookie de session -----------------------------------------------------
REFRESH_COOKIE_NAME=uswap_refresh
# true des que l'application est servie en HTTPS.
COOKIE_SECURE=true
# lax : frontend et API sur la MEME origine via le proxy Nginx.
COOKIE_SAMESITE=lax

# --- Origines publiques ----------------------------------------------------
# Domaine reel servi par le Nginx de l'hote (HTTPS). Doit etre identique a
# PUBLIC_APP_URL / CORS_ORIGIN ci-dessus.

# --- E-mails ---------------------------------------------------------------
#
# Le compte SMTP de developpement (backend_new/.env, ex. Gmail personnel) ne
# doit pas etre recopie ici : utiliser une adresse d'expedition de
# l'organisation, avec son propre mot de passe d'application.
#
# ⚠️  EN PRODUCTION : laisser `console` revient à ne JAMAIS envoyer d'e-mail.
# Les liens d'activation et les notifications sont alors seulement écrits
# dans les journaux du conteneur. Passer à `smtp` et renseigner les quatre
# variables ci-dessous (démarrage : le backend vérifie la connexion et
# journalise l'erreur réelle du fournisseur).
#
#   console | json | smtp
#     console : aucune sortie (recette uniquement)
#     json    : fichiers dans var/mail (recette : vérifier sans envoyer)
#     smtp    : envoi réel
MAIL_DRIVER=smtp

# Expéditeur affiché. Le domaine doit être autorisé par le fournisseur SMTP
# (Gmail, Brevo, OVH…) sinon le message est classé en indésirable ou refusé.
MAIL_FROM=uSwap <no-reply@uswap.example.org>

# Gmail : smtp.gmail.com / 587 / false + « mot de passe d'application ».
# (Le mot de passe du compte Google n'est jamais accepté.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
# Alias acceptés : SMTP_PASS (documentation) ou SMTP_PASSWORD (historique).
SMTP_PASS=

# --- Reglages metier par defaut -------------------------------------------
# Appliques UNIQUEMENT aux nouvelles stations. Les valeurs deja enregistrees
# via l'ecran /admin/settings restent maitresses et ne sont pas ecrasees.
TOLERANCE_MINUTES=5
GEOFENCE_RADIUS_METERS=150
MIN_REST_HOURS=8
WEEKLY_HOURS_LIMIT=48
DEFAULT_EMAIL_DOMAIN=uswap.local
INVITATION_VALIDITY_HOURS=48
NOTIFICATION_RETENTION_DAYS=90
MAX_ATTACHMENT_MB=5
SUPPORT_EMAIL=support@uswap.local

# --- Connexion Google (SSO) ------------------------------------------------
#
# OU METTRE L'IDENTIFIANT : ici, et NULLE PART AILLEURS.
#
#   GOOGLE_CLIENT_ID=449904699288-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
#
# ATTENTION : la valeur complete se termine par « .apps.googleusercontent.com ».
# Le seul nombre (449904699288) est le numero de PROJET Google Cloud, pas
# l'identifiant client : la connexion echouera avec cette valeur seule.
# Copier la ligne « ID client » entiere depuis la console Google Cloud.
#
# C'est la SEULE ligne a remplir pour la connexion Google. Le compose.yaml la
# transmet au backend (GOOGLE_CLIENT_ID) ET au frontend au moment du BUILD
# Docker (VITE_GOOGLE_CLIENT_ID) : il n'y a pas de second fichier a modifier.
#
# Ne PAS mettre l'identifiant dans frontend_new/frontend/.env : ce fichier
# sert au developpement local (npm run dev) et n'entre jamais dans l'image.
#
# --- ET LE « CLIENT SECRET » ? --------------------------------------------
# Il n'y a RIEN a mettre : uSwap n'en a pas besoin et ne le lit pas.
#
# Le flux utilise est « Google Identity Services » cote navigateur : le
# frontend recoit un jeton d'identite (id_token) signe par Google, et le
# backend le verifie aupres de Google (oauth2.googleapis.com/tokeninfo) en
# controlant que l'audience correspond a GOOGLE_CLIENT_ID. Aucun echange de
# code contre un jeton n'a lieu cote serveur, donc aucun client secret.
#
# Le client secret ne sert que pour un flux « code d'autorisation » serveur
# (redirection OAuth classique), qui n'est pas implemente ici. Le garder
# prive dans la console Google Cloud, sans le copier dans ce fichier.
#
# Identifiant OAuth cree dans la console Google Cloud, type « Application Web ».
# Origines JavaScript autorisees a declarer dans la console :
#   https://<domaine-du-serveur>
#   http://localhost:5173        (developpement local uniquement)
#
# Laisser vide desactive simplement le bouton Google sur l'ecran de connexion.
GOOGLE_CLIENT_ID=
# Domaines autorisés : seuls les comptes professionnels uPowa peuvent utiliser
# Google. Un Gmail personnel est refusé même si l'adresse existe dans uSwap.
GOOGLE_ALLOWED_DOMAINS=upowa.org

# --- Google Maps (carte de creation de station) ----------------------------
# Cle PUBLIQUE de la Maps JavaScript API, transmise au frontend au BUILD Docker
# (deploy/compose.yaml : `VITE_GOOGLE_MAPS_API_KEY`).
#
# Creation : console Google Cloud -> APIs et services -> Identifiants ->
# « Creer des identifiants » -> « Cle d'API ». Puis activer, dans
# « Bibliotheque », les trois API suivantes :
#   - Maps JavaScript API   (fond de carte, marqueur, perimetre)
#   - Places API            (autocompletion des adresses)
#   - Geocoding API         (adresse <-> coordonnees)
#
# Restriction OBLIGATOIRE de la cle (sinon elle est exploitable par n'importe
# qui) : « Restrictions relatives aux applications » -> Sites web ->
#   https://<domaine-du-serveur>/*
#   http://localhost:5173/*        (developpement local uniquement)
#
# Vide : la carte reste fonctionnelle avec OpenStreetMap + Nominatim, mais les
# adresses et le fond ne sont plus ceux de Google Maps.
VITE_GOOGLE_MAPS_API_KEY=

# --- Notifications SMS : DESACTIVEES --------------------------------------
#
# QUI DOIT FOURNIR SMS_ENDPOINT / SMS_TOKEN ? Personne pour l'instant.
#
# Ces deux valeurs viennent d'un FOURNISSEUR SMS (Orange SMS API, Twilio,
# Infobip, Vonage...) : c'est un compte payant, ouvert par l'organisation
# (uPowa), pas par le developpeur. Tant qu'aucun compte n'existe, il n'y a
# RIEN a renseigner : laisser SMS_DRIVER=console.
#
#   console : le SMS est seulement ecrit dans les journaux du conteneur.
#             Aucun envoi, aucun cout. C'est le mode livre.
#   http    : envoi reel. A activer UNIQUEMENT quand l'organisation a fourni
#             l'URL du fournisseur et son jeton d'acces.
#
# Contrat attendu par le fournisseur (deja implemente cote backend) :
#   POST <SMS_ENDPOINT>   Authorization: Bearer <SMS_TOKEN>
#   { "to": "2376XXXXXXXX", "message": "...", "sender": "uSwap" }
SMS_DRIVER=console
SMS_ENDPOINT=
SMS_TOKEN=
SMS_SENDER=uSwap

# --- Notifications Web Push : DESACTIVEES ----------------------------------
# Les notifications push navigateur ne sont pas livrees : rien a renseigner.
# Le compose.yaml force DISABLE_WEB_PUSH=true et ne transmet aucune cle VAPID,
# meme si d'anciennes variables trainaient dans un .env existant.
DISABLE_WEB_PUSH=true
