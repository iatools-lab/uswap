DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/uswap"
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
PORT=3000
NODE_ENV=development

# Must match the browser origin exactly, otherwise CORS silently blocks the
# frontend. Vite serves on 127.0.0.1:5173 by default; list both forms.
CORS_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
# ---------------------------------------------------------------------------
# E-mails transactionnels (invitations, reinitialisation de mot de passe)
# ---------------------------------------------------------------------------
# Le backend envoie via Resend (https://resend.com). Tant que RESEND_API_KEY
# est vide, AUCUN e-mail ne part : l'invitation est bien generee en base, mais
# elle n'est pas delivree. Dans ce cas l'API renvoie un champ `activationUrl`
# et journalise le lien, pour que l'activation reste possible manuellement.
#
# Pieges a connaitre :
#  - MAIL_FROM doit utiliser un domaine VERIFIE dans Resend. En test, utilisez
#    "Uswap <onboarding@resend.dev>", sinon l'envoi est refuse.
#  - En mode test, Resend n'accepte comme destinataire que l'adresse du compte
#    Resend lui-meme.
#  - Pour activer un compte sans e-mail :
#    node scripts/activate-user.cjs <email> [motDePasse]
RESEND_API_KEY=""
MAIL_FROM="Uswap <onboarding@resend.dev>"

# Lien d'activation / reinitialisation construit par le backend : doit pointer
# sur l'origine servie par le frontend (proxy Vite compris).
FRONTEND_URL="http://127.0.0.1:5173"
ADMIN_SEED_EMAIL="admin@upowa.org"
ADMIN_SEED_PASSWORD="CHANGE_ME_WITH_A_STRONG_PASSWORD"
ACCESS_TOKEN_TTL_SECONDS=900

# Password given to every account created by the demo seed
# (npx prisma db seed). Change it here before running the seed if you prefer.
DEMO_PASSWORD="Uswap2026!Demo"