DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/uswap"
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
PORT=3000
NODE_ENV=development

# Must match the browser origin exactly, otherwise CORS silently blocks the
# frontend. Vite serves on 127.0.0.1:5173 by default; list both forms.
CORS_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
# ---------------------------------------------------------------------------
# E-mails transactionnels via SMTP
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-sender@example.com"
# Utiliser un mot de passe d'application, jamais le mot de passe du compte.
SMTP_PASS="CHANGE_ME_WITH_AN_APP_PASSWORD"
# L'expediteur doit etre l'adresse authentifiee (sinon le message est rejete).
MAIL_FROM="uSwap <your-sender@example.com>"

# Lien d'activation / reinitialisation construit par le backend : doit pointer
# sur l'origine servie par le frontend (proxy Vite compris).
FRONTEND_URL="http://127.0.0.1:5173"
ADMIN_SEED_EMAIL="admin@example.org"
ADMIN_SEED_PASSWORD="CHANGE_ME_WITH_A_STRONG_PASSWORD"
ACCESS_TOKEN_TTL_SECONDS=900

# Password given to every account created by the demo seed
# (npx prisma db seed). Change it here before running the seed if you prefer.
DEMO_PASSWORD="CHANGE_ME_WITH_A_DEMO_PASSWORD"

# ---------------------------------------------------------------------------
# Connexion Google (SSO) — optionnel
# ---------------------------------------------------------------------------
# Identifiant OAuth public, cree dans la console Google Cloud
# (type « Application Web »). Vide -> le bouton Google n'apparait pas et la
# connexion par mot de passe reste seule disponible.
# Le frontend lit le MEME identifiant via VITE_GOOGLE_CLIENT_ID
# (frontend_new/frontend/.env).
GOOGLE_CLIENT_ID=""
# Seuls ces domaines peuvent se connecter par Google. Un Gmail personnel est
# refuse, meme si l'adresse existe deja dans uSwap.
GOOGLE_ALLOWED_DOMAINS="upowa.org"

# ---------------------------------------------------------------------------
# Canal SMS des notifications — optionnel
# ---------------------------------------------------------------------------
# OPT-IN par utilisateur : un SMS ne part que si le compte a active le SMS dans
# ses preferences ET possede un numero de telephone.
#   console : ecrit dans les journaux, aucun envoi reel (recette)
#   http    : POST JSON vers SMS_ENDPOINT, avec SMS_TOKEN en Bearer
# Corps envoye : { "to": "2376XXXXXXXX", "message": "...", "sender": "uSwap" }
SMS_DRIVER=console
SMS_ENDPOINT=""
SMS_TOKEN=""
SMS_SENDER=uSwap

# Web Push (optional but recommended for PWA push notifications)
VAPID_SUBJECT="mailto:admin@example.org"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
