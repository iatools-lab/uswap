generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                  @id @default(uuid())
  fullName                   String
  email                      String                  @unique
  password                   String
  role                       Role
  isActive                   Boolean                 @default(false)
  disabledAt                 DateTime?
  stationId                  String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  resetTokenExpires          DateTime?
  resetTokenHash             String?
  address                    String?
  invitationTokenExpires     DateTime?
  invitationTokenHash        String?
  phoneNumber                String?
  tokenVersion               Int                     @default(0)
  attendances                Attendance[]
  attendanceCorrections      AttendanceCorrection[]  @relation("AttendanceCorrectionBy")
  attendanceQrsCreated       AttendanceQr[]          @relation("AttendanceQrCreatedBy")
  incidentsAffected          Incident[]              @relation("IncidentAffectedSwapper")
  incidentsAssigned          Incident[]              @relation("IncidentAssignee")
  incidentsReported          Incident[]              @relation("IncidentReporter")
  incidentActions            IncidentAction[]
  leaveBalance               LeaveBalance?
  leaveRequests              LeaveRequest[]
  leaveSyncOperations        LeaveSyncOperation[]
  notifications              Notification[]
  notificationPreference     NotificationPreference?
  refreshTokens              RefreshToken[]
  replacementAssignedBy      ReplacementRequest[]    @relation("ReplacementAssignedBy")
  replacementAssignments     ReplacementRequest[]    @relation("ReplacementAssignedTo")
  replacementOriginalShifts  ReplacementRequest[]    @relation("ReplacementOriginalSwapper")
  replacementRequestsCreated ReplacementRequest[]    @relation("ReplacementRequestedByUser")
  scheduledReports           ScheduledReport[]
  shifts                     Shift[]
  shiftChangesMade           ShiftChange[]           @relation("ShiftChangeMadeBy")
  newShiftChanges            ShiftChange[]           @relation("NewSwapper")
  previousShiftChanges       ShiftChange[]           @relation("PreviousSwapper")
  station                    Station?                @relation("PrimaryStationUsers", fields: [stationId], references: [id])
  auditLogs                  UserAuditLog[]          @relation("AuditedUser")
  communicationLogs          CommunicationLog[]
  pushSubscriptions          PushSubscription[]
  stationScopes              UserStationScope[]

  @@index([stationId])
  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Station {
  id                       String             @id @default(uuid())
  name                     String             @unique
  location                 String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  checkinQrTtl             Int                @default(300)
  checkoutQrTtl            Int                @default(300)
  contactName              String?
  contactPhone             String?
  latenessToleranceMinutes Int                @default(0)
  minRestHours             Int                @default(8)
  timezone                 String             @default("Africa/Douala")
  weeklyHoursLimit         Int                @default(72)
  isActive                 Boolean            @default(true)
  latitude                 Float?
  longitude                Float?
  /// Street address and city as captured by the station form. `location` is
  /// kept for older rows; these are what the station card displays.
  address                  String?
  city                     String?
  attendances              Attendance[]
  attendanceQrs            AttendanceQr[]
  incidents                Incident[]
  planningStations         PlanningStation[]
  shifts                   Shift[]
  shiftTemplates           ShiftTemplate[]
  users                    User[]             @relation("PrimaryStationUsers")
  userStationScopes        UserStationScope[]

  @@index([isActive])
}

model UserStationScope {
  userId    String
  stationId String
  createdAt DateTime @default(now())
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, stationId])
  @@index([stationId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model LeaveRequest {
  id             String               @id @default(uuid())
  userId         String
  startDate      DateTime
  endDate        DateTime
  type           LeaveType
  reason         String?
  status         LeaveStatus          @default(PENDING)
  externalId     String?
  lastSyncedAt   DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  /// Offline-first reference supplied by the client, used to deduplicate a
  /// replayed request (one queue item must never create two leaves).
  clientRef      String?              @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncOperations LeaveSyncOperation[]

  @@index([userId])
  @@index([startDate, endDate])
  @@index([status])
}

model Planning {
  id        String            @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  status    PlanningStatus    @default(DRAFT)
  createdBy String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  stations  PlanningStation[]
  shifts    Shift[]

  @@index([startDate, endDate])
  @@index([status])
}

model PlanningStation {
  planningId String
  stationId  String
  planning   Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  station    Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([planningId, stationId])
  @@index([stationId])
}

model Shift {
  id                  String               @id @default(uuid())
  stationId           String
  swapperId           String?
  startTime           DateTime
  endTime             DateTime
  createdAt           DateTime             @default(now())
  planningId          String?
  attendances         Attendance[]
  attendanceQrs       AttendanceQr[]
  replacementRequests ReplacementRequest[]
  planning            Planning?            @relation(fields: [planningId], references: [id])
  station             Station              @relation(fields: [stationId], references: [id])
  swapper             User?                @relation(fields: [swapperId], references: [id])
  shiftChanges        ShiftChange[]

  @@index([stationId, startTime])
  @@index([swapperId, startTime])
  @@index([planningId])
  @@index([startTime, endTime])
}

model Attendance {
  id                String                 @id @default(uuid())
  shiftId           String
  swapperId         String
  stationId         String
  status            AttendanceStatus       @default(EXPECTED)
  checkInAt         DateTime?
  checkOutAt        DateTime?
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  absenceReason     String?
  correctedAt       DateTime?
  correctedById     String?
  correctionReason  String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  shift             Shift                  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  station           Station                @relation(fields: [stationId], references: [id])
  swapper           User                   @relation(fields: [swapperId], references: [id])
  correctionHistory AttendanceCorrection[]

  @@unique([shiftId, swapperId])
  @@index([swapperId, status])
  @@index([stationId, status])
  @@index([shiftId])
}

model AttendanceQr {
  id          String           @id @default(uuid())
  stationId   String
  shiftId     String
  type        AttendanceQrType
  tokenHash   String           @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdAt   DateTime         @default(now())
  createdBy   User             @relation("AttendanceQrCreatedBy", fields: [createdById], references: [id])
  shift       Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  station     Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([shiftId, type])
  @@index([stationId, expiresAt])
  @@index([expiresAt])
}

model AttendanceCorrection {
  id            String           @id @default(uuid())
  attendanceId  String
  correctedById String
  oldStatus     AttendanceStatus
  newStatus     AttendanceStatus
  oldCheckInAt  DateTime?
  newCheckInAt  DateTime?
  oldCheckOutAt DateTime?
  newCheckOutAt DateTime?
  reason        String
  evidenceUrl   String?
  createdAt     DateTime         @default(now())
  attendance    Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  correctedBy   User             @relation("AttendanceCorrectionBy", fields: [correctedById], references: [id])

  @@index([attendanceId])
  @@index([correctedById])
}

model ReplacementRequest {
  id                String            @id @default(uuid())
  shiftId           String
  originalSwapperId String
  assignedSwapperId String?
  requestedById     String
  assignedById      String?
  reason            String?
  source            String?
  clientRef         String?           @unique
  status            ReplacementStatus @default(OPEN)
  requestedAt       DateTime          @default(now())
  assignedAt        DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assignedBy        User?             @relation("ReplacementAssignedBy", fields: [assignedById], references: [id])
  assignedSwapper   User?             @relation("ReplacementAssignedTo", fields: [assignedSwapperId], references: [id])
  originalSwapper   User              @relation("ReplacementOriginalSwapper", fields: [originalSwapperId], references: [id])
  requestedBy       User              @relation("ReplacementRequestedByUser", fields: [requestedById], references: [id])
  shift             Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([originalSwapperId])
  @@index([assignedSwapperId])
  @@index([status])
  @@index([requestedAt])
}

model ShiftChange {
  id                String          @id @default(uuid())
  shiftId           String
  previousSwapperId String?
  newSwapperId      String?
  changedById       String
  type              ShiftChangeType
  reason            String?
  oldStartTime      DateTime?
  oldEndTime        DateTime?
  newStartTime      DateTime?
  newEndTime        DateTime?
  createdAt         DateTime        @default(now())
  changedBy         User            @relation("ShiftChangeMadeBy", fields: [changedById], references: [id])
  newSwapper        User?           @relation("NewSwapper", fields: [newSwapperId], references: [id])
  previousSwapper   User?           @relation("PreviousSwapper", fields: [previousSwapperId], references: [id])
  shift             Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([previousSwapperId])
  @@index([newSwapperId])
  @@index([changedById])
  @@index([createdAt])
}

model UserAuditLog {
  id        String   @id @default(uuid())
  userId    String
  changedBy String
  changes   Json
  createdAt DateTime @default(now())
  user      User     @relation("AuditedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  /// Optional deep-link target, e.g. /app/supervision/operations
  link      String?
  /// Business reference (shift id, replacement request id...) for tracing.
  entityId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Reusable shift pattern for a station (label + window + break). Mirrors the
/// shape the station screen reads: startTime/endTime/breakStart/breakEnd are
/// "HH:mm" strings, durations are derived minutes.
model ShiftTemplate {
  id              String                 @id @default(uuid())
  stationId       String
  label           String
  startTime       String
  endTime         String
  breakStart      String?
  breakEnd        String?
  breakMinutes    Int                    @default(0)
  durationMinutes Int
  isActive        Boolean                @default(true)
  revision        Int                    @default(1)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  station         Station                @relation(fields: [stationId], references: [id], onDelete: Cascade)
  versions        ShiftTemplateVersion[]

  @@unique([stationId, startTime, endTime])
  @@index([stationId])
}

/// Immutable snapshot written on every create/update, so the history screen
/// can show what the template looked like at each revision.
model ShiftTemplateVersion {
  id              String        @id @default(uuid())
  templateId      String
  label           String
  startTime       String
  endTime         String
  breakStart      String?
  breakEnd        String?
  breakMinutes    Int
  durationMinutes Int
  isActive        Boolean
  revision        Int
  createdAt       DateTime      @default(now())
  template        ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// One row per user: the notification channels the account accepts. Absence
/// of a row means "all channels on", matching the frontend defaults.
model NotificationPreference {
  userId            String   @id
  inApp             Boolean  @default(true)
  email             Boolean  @default(true)
  push              Boolean  @default(false)
  digest            Boolean  @default(true)
  quietHoursEnabled Boolean  @default(false)
  quietHoursStart   String?  @default("22:00")
  quietHoursEnd     String?  @default("07:00")
  retentionDays     Int      @default(30)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Operational incident tracked by supervisors (sprint 4/5 scope).
model Incident {
  id                String           @id @default(uuid())
  stationId         String
  affectedSwapperId String?
  reporterId        String
  assigneeId        String?
  category          IncidentCategory @default(OTHER)
  severity          IncidentSeverity @default(MEDIUM)
  status            IncidentStatus   @default(REPORTED)
  title             String
  description       String
  occurredAt        DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  resolvedAt        DateTime?
  closedAt          DateTime?
  resolution        String?
  affectedSwapper   User?            @relation("IncidentAffectedSwapper", fields: [affectedSwapperId], references: [id])
  assignee          User?            @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  reporter          User             @relation("IncidentReporter", fields: [reporterId], references: [id])
  station           Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  actions           IncidentAction[]

  @@index([stationId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

/// Immutable audit trail of every incident transition.
model IncidentAction {
  id         String             @id @default(uuid())
  incidentId String
  authorId   String
  type       IncidentActionType
  fromStatus IncidentStatus?
  toStatus   IncidentStatus?
  comment    String
  createdAt  DateTime           @default(now())
  author     User               @relation(fields: [authorId], references: [id])
  incident   Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

/// Network-wide settings managed from the admin settings screen. A single row
/// is kept (id = 1) and every change is mirrored into GlobalSettingRevision.
model GlobalSetting {
  id                        Int      @id @default(1)
  sessionMinutes            Int      @default(60)
  invitationValidityHours   Int      @default(72)
  maxAttachmentMb           Int      @default(10)
  notificationRetentionDays Int      @default(30)
  supportEmail              String   @default("support@uswap.app")
  webhookSecretConfigured   Boolean  @default(false)
  revision                  Int      @default(1)
  updatedBy                 String?
  updatedAt                 DateTime @updatedAt
  createdAt                 DateTime @default(now())
}

/// Snapshot of GlobalSetting before/after each edit, so the admin screen can
/// display a revision history.
model GlobalSettingRevision {
  id        String   @id @default(uuid())
  revision  Int
  actorId   String?
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@index([revision])
}

model CommunicationLog {
  id                String   @id @default(uuid())
  userId            String
  channel           String   @default("EMAIL")
  type              String
  recipient         String
  subject           String
  status            String
  providerMessageId String?
  errorMessage      String?
  actionUrl         String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([recipient, createdAt])
  @@index([status])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ScheduledReportRun {
  id                String                @id @default(uuid())
  scheduledReportId String
  status            String
  format            ScheduledReportFormat
  recipients        String[]
  from              DateTime?
  to                DateTime?
  scope             String
  stationId         String?
  generatedAt       DateTime              @default(now())
  sentAt            DateTime?
  errorMessage      String?

  scheduledReport ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)

  @@index([scheduledReportId, generatedAt])
  @@index([status, generatedAt])
}

model ReportExportAudit {
  id        String   @id @default(uuid())
  actorId   String
  format    String
  from      DateTime
  to        DateTime
  stationId String?
  swapperId String?
  scope     String
  sections  String[]
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Recurring report delivery configured by an administrator.
model ScheduledReport {
  id         String                   @id @default(uuid())
  ownerId    String
  name       String
  frequency  ScheduledReportFrequency @default(WEEKLY)
  format     ScheduledReportFormat    @default(XLSX)
  scope      String                   @default("NETWORK")
  stationId  String?
  recipients String[]
  sections   String[]
  isActive   Boolean                  @default(true)
  nextRunAt  DateTime
  lastRunAt  DateTime?
  createdAt  DateTime                 @default(now())
  owner      User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  runs       ScheduledReportRun[]

  @@index([ownerId])
  @@index([nextRunAt])
}

model LeaveBalance {
  id           String   @id @default(uuid())
  swapperId    String   @unique
  year         Int
  entitledDays Int      @default(30)
  usedDays     Int      @default(0)
  pendingDays  Int      @default(0)
  syncedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  swapper      User     @relation(fields: [swapperId], references: [id], onDelete: Cascade)
}

/// One row per attempt to push a leave change to the external system.
/// Idempotency key prevents an offline replay from creating a duplicate.
model LeaveSyncOperation {
  id             String          @id @default(uuid())
  leaveRequestId String
  userId         String
  action         LeaveSyncAction
  status         LeaveSyncStatus @default(SYNCED)
  idempotencyKey String          @unique
  attempts       Int             @default(1)
  lastAttemptAt  DateTime?
  completedAt    DateTime?
  lastError      String?
  createdAt      DateTime        @default(now())
  leaveRequest   LeaveRequest    @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leaveRequestId])
}

enum Role {
  ADMIN
  SUPERVISOR
  STATION_CHIEF
  SWAPPER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
  FAMILY
}

enum PlanningStatus {
  DRAFT
  PUBLISHED
}

enum AttendanceStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  ABSENT
  JUSTIFIED
}

enum AttendanceQrType {
  START
  END
}

enum ReplacementStatus {
  OPEN
  ASSIGNED
  CANCELLED
  RESOLVED
}

enum ShiftChangeType {
  ASSIGNMENT
  REASSIGNMENT
  REPLACEMENT
  SWAP
  MANUAL_EDIT
  TIME_CHANGE
}

enum NotificationKind {
  REPLACEMENT_REQUESTED
  REPLACEMENT_ASSIGNED
  SHIFT_CHANGED
  ABSENCE_RECORDED
  ACCOUNT_ACTIVATED
  INCIDENT
  LEAVE
  ATTENDANCE
  PLANNING
  SYSTEM
}

/// Business incident raised by a station chief and handled by a supervisor.
/// Status follows the state machine exposed by the frontend IncidentCenter:
/// REPORTED -> TO_REVIEW -> ACKNOWLEDGED -> IN_PROGRESS -> RESOLVED -> CLOSED.
enum IncidentStatus {
  REPORTED
  TO_REVIEW
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentCategory {
  ABSENCE
  LATENESS
  EQUIPMENT
  SECURITY
  CUSTOMER
  OTHER
}

enum IncidentActionType {
  CREATED
  QUALIFIED
  COMMENT
  RESOLVED
  CLOSED
}

enum ScheduledReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduledReportFormat {
  XLSX
  CSV
}

/// Tracks the (idempotent) propagation of a leave request to the external HR
/// system, so the swapper screen can show "synced / retrying / failed".
enum LeaveSyncAction {
  CREATE
  UPDATE
  CANCEL
}

enum LeaveSyncStatus {
  QUEUED
  PROCESSING
  SYNCED
  FAILED
}
