# ---------------------------------------------------------------------------
# uSwap backend_new — variables d'environnement
# Copier ce fichier en .env puis adapter les valeurs.
# ---------------------------------------------------------------------------

# Serveur HTTP
PORT=3000
NODE_ENV=development
# Origine(s) autorisee(s) pour le cookie de session. Le frontend Vite fait un
# proxy vers /api, donc l'origine est celle du frontend en dev.
CORS_ORIGIN=http://127.0.0.1:5173

# Base de donnees. Par defaut SQLite (zero installation).
# En production, basculer DATABASE_URL sur PostgreSQL, par ex. :
#   postgresql://uswap:secret@localhost:5432/uswap?schema=public
DATABASE_URL="file:./dev.db"

# --- Session / JWT -------------------------------------------------------
# Chaine de 32+ caracteres minimum. A regenerer en production.
JWT_SECRET="change-me-uswap-access-secret-please-32-chars"
JWT_REFRESH_SECRET="change-me-uswap-refresh-secret-please-32-chars"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Duree d'inactivite avant expiration de session (le frontend attend 1800).
SESSION_IDLE_SECONDS=1800
# Duree maximale d'une session, quelle que soit l'activite.
SESSION_ABSOLUTE_SECONDS=43200

# Nom du cookie de refresh HttpOnly. Le frontend n'y touche jamais.
REFRESH_COOKIE_NAME=uswap_refresh
# Passer a "true" lorsque l'app est servie en HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- URL publique (utilisee dans les liens d'invitation / reset) ----------
PUBLIC_APP_URL=http://127.0.0.1:5173

# --- Emails ---------------------------------------------------------------
# "console" n'envoie rien, il ecrit le message complet dans les logs.
MAIL_DRIVER=console
MAIL_FROM="uSwap <no-reply@uswap.local>"
# MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Web Push (notifications navigateur) ---------------------------------
# Generer les cles avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:no-reply@uswap.local"
# Le frontend lit cette cle sous le nom VITE_VAPID_PUBLIC_KEY.
ENABLE_WEB_PUSH=false

# --- Regles metier par defaut (surchargeables en base via /admin/settings) -
DEFAULT_EMAIL_DOMAIN=uswap.local
DEFAULT_MAX_WEEKLY_HOURS=48
DEFAULT_MIN_REST_HOURS=12
DEFAULT_MAX_CONSECUTIVE_DAYS=6
DEFAULT_LEAVE_NOTICE_DAYS=14
DEFAULT_COVERAGE_THRESHOLD=0.8
DEFAULT_ACCESS_TTL_HOURS=72
DEFAULT_IDLE_TIMEOUT_SECONDS=1800
