# ---------------------------------------------------------------------------
# uSwap — variables d'environnement de l'API (backend_new)
#
# Copier ce fichier en `.env` puis renseigner les valeurs :
#   cp backend_new/.env.example backend_new/.env
#
# Le fichier `.env` n'est JAMAIS versionne : il est ignore par .gitignore et
# exclu des images Docker (.dockerignore). Aucun secret reel ne figure ici.
# En production (Docker), la configuration arrive par `deploy/.env`.
# ---------------------------------------------------------------------------

# Serveur HTTP
PORT=3000
NODE_ENV=development
# Origine(s) autorisee(s) pour le cookie de session. Le frontend Vite fait un
# proxy vers /api, donc l'origine est celle du frontend en dev.
CORS_ORIGIN=http://127.0.0.1:5173

# Base de donnees PostgreSQL (le schema Prisma est en provider "postgresql").
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE?schema=public
# Les caracteres speciaux doivent etre encodes (%40 pour @).
DATABASE_URL="postgresql://uswap:mot-de-passe@localhost:5432/uswap?schema=public"

# --- Session / JWT -------------------------------------------------------
# Chaine de 32+ caracteres minimum. A regenerer en production.
JWT_SECRET="CHANGER-secret-acces-aleatoire-32-caracteres-minimum"
JWT_REFRESH_SECRET="CHANGER-secret-refresh-aleatoire-32-caracteres-minimum"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Duree d'inactivite avant expiration de session (le frontend attend 1800).
SESSION_IDLE_SECONDS=1800
# Duree maximale d'une session, quelle que soit l'activite.
SESSION_ABSOLUTE_SECONDS=43200

# Nom du cookie de refresh HttpOnly. Le frontend n'y touche jamais.
REFRESH_COOKIE_NAME=uswap_refresh
# Passer a "true" lorsque l'app est servie en HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- URL publique (utilisee dans les liens d'invitation / reset) ----------
PUBLIC_APP_URL=http://127.0.0.1:5173

# --- Emails ---------------------------------------------------------------
# "console" n'envoie rien, il ecrit le message complet dans les logs.
# "json" ecrit dans var/mail (recette) ; "smtp" envoie reellement.
MAIL_DRIVER=console
MAIL_FROM="uSwap <no-reply@example.org>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Mot de passe d'application du fournisseur (jamais celui du compte).
SMTP_PASSWORD=

# --- Web Push (notifications navigateur) ---------------------------------
# Generer les cles avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:no-reply@uswap.local"
# Le frontend lit cette cle sous le nom VITE_VAPID_PUBLIC_KEY.
ENABLE_WEB_PUSH=false

# --- Regles metier par defaut (surchargeables en base via /admin/settings) -
# Noms reellement lus par src/config/configuration.ts.
DEFAULT_EMAIL_DOMAIN=uswap.local
TOLERANCE_MINUTES=5
GEOFENCE_RADIUS_METERS=150
MIN_REST_HOURS=8
WEEKLY_HOURS_LIMIT=48
INVITATION_VALIDITY_HOURS=48
NOTIFICATION_RETENTION_DAYS=90
MAX_ATTACHMENT_MB=5
SUPPORT_EMAIL=support@example.org

# --- Integration RH externe (desactivee par defaut) -----------------------
LEAVE_SYNC_ENABLED=false
LEAVE_SYNC_ENDPOINT=
LEAVE_SYNC_TOKEN=
LEAVE_SYNC_WEBHOOK_SECRET=

# --- Seed de demonstration (npm run seed) ---------------------------------
# Mot de passe commun des comptes de demonstration crees par le seed.
DEMO_PASSWORD=Choisir-Un-Mot-De-Passe-Demo
ADMIN_SEED_EMAIL=admin@example.org
ADMIN_SEED_PASSWORD=Choisir-Un-Mot-De-Passe-Admin
